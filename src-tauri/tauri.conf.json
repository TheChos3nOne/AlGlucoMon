{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlGlucoMon",
  "version": "0.1.2",
  "identifier": "com.alglucomon.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "AlGlucoMon",
        "url": "index.html",
        "width": 256,
        "height": 116,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "settings",
        "title": "AlGlucoMon — Settings",
        "url": "index.html#settings",
        "width": 460,
        "height": 680,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Almoukhtar Amiouni",
    "copyright": "Copyright (C) 2026 Almoukhtar Amiouni",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
